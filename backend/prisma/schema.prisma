generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model ConnectLink {
  id        Int      @id @default(autoincrement())
  title     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Offering {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  price       Float
  coverImage  String?
  coverPageData String?
  pdfUrl      String?
  bundles     Bundle[]
  createdAt   DateTime @default(now())
}

model Bundle {
  id          Int        @id @default(autoincrement())
  title       String
  description      String?
  price            Float
  hasConsultation  Boolean    @default(false)
  offerings        Offering[]
  createdAt        DateTime   @default(now())
}

model ConsultationSetting {
  id          Int      @id @default(1)
  price       Float    @default(50.0)
  duration    Int      @default(30)
  description String?
}

model Booking {
  id        Int      @id @default(autoincrement())
  eventId   String
  slotStart DateTime
  slotEnd   DateTime
  status    String   @default("PENDING") // PENDING, PAID, FAILED, TIMEOUT
  expiresAt DateTime
  name      String?
  email     String?
  phone     String?
  topic     String?
  orderId   String?  @unique
  createdAt DateTime @default(now())
}

model PdfPurchase {
  id        Int      @id @default(autoincrement())
  orderId   String   @unique
  paymentId String?
  name      String
  email     String
  phone     String?
  pdfId     String
  amount    Float
  status    String   @default("CREATED") // CREATED, SUCCESS, FAILED
  isFulfilled Boolean @default(false)
  createdAt DateTime @default(now())
}

model BundlePurchase {
  id           Int      @id @default(autoincrement())
  orderId      String   @unique
  paymentId    String?
  name         String
  email        String
  phone        String?
  bundleId     String
  selectedPdfs String   @default("[]") // JSON array of pdf IDs
  amount       Float
  status       String   @default("CREATED") // CREATED, SUCCESS, FAILED
  isFulfilled  Boolean  @default(false)
  createdAt    DateTime @default(now())
}
